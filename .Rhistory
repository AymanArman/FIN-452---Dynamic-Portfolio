library(tidyquant)
library(tidyverse)
library(purrr)
library(rlang)
library(lubridate)
tickers <- c("NVDA", "XOM", "AMZN", "WM")
start_date <- as.Date("2015-01-01") - 1
end_date <- Sys.Date()
df <-
tq_get(tickers, get = "stock.prices", complete_cases = TRUE) %>%
select(symbol, date, open, high, close) %>%
group_by(symbol)
empty_prices <- tibble(
symbol = character(),
date   = as.Date(character()),
open   = double(),
high   = double(),
close  = double()
)
empty_splits <- tibble(
symbol = character(),
date   = as.Date(character()),
splits = double()
)
get_splits <- function(sym) {
x <- tryCatch(
tq_get(sym, get = "splits", complete_cases = FALSE),
warning = function(w) NULL,
error   = function(e) NULL
)
if (is.null(x) || nrow(x) == 0) empty_splits else {
x %>% transmute(symbol, date, splits = value)
}
df_splits <- map_dfr(tickers, get_splits)
empty_dividends <- tibble(
symbol    = character(),
date      = as.Date(character()),
dividends = double()
)
get_dividends <- function(sym) {
x <- tryCatch(
tq_get(sym, get = "dividends", complete_cases = FALSE),
warning = function(w) NULL,
error   = function(e) NULL
)
if (is.null(x) || nrow(x) == 0) empty_dividends else {
x %>% transmute(symbol, date, dividends = value)
}
df_dividends <- map_dfr(tickers, get_dividends)
daily_data <- df %>%
left_join(df_dividends, by = c("symbol","date")) %>%
left_join(df_splits,    by = c("symbol","date")) %>%
select(-high)
daily_data <- daily_data %>%
mutate(
dividends = replace_na(dividends, 0),
splits    = replace_na(splits, 1)
)
daily_data <- daily_data %>%
group_by(symbol) %>%
arrange(date) %>%
mutate(
ret_co = open  / lag(close) - 1,
ret_cc = close / lag(close) - 1,
ret_oc = close / open - 1,
) %>%
ungroup() %>%
drop_na() %>%
group_by(symbol, ym = floor_date(date, "month")) %>%
mutate(
month_flag = case_when(
date == min(date) ~ 1,
date == max(date) ~ 2,
TRUE ~ 0
)
) %>%
ungroup() %>%
select(-ym)
tmp <- daily_data %>%
select(date, symbol, open, close, ret_co, ret_cc, ret_oc, dividends, splits, month_flag) %>%
group_by(symbol)
stock_dfs <- tmp %>%
group_split(.keep = TRUE)
portfolio_value0 <- 100000
weights <- tibble::tribble(
~symbol, ~target_weight,
"NVDA",  0.25,
"XOM",   0.25,
"AMZN",  0.25,
"WM",    0.25
)
wide_weights <- pivot_wider(weights, names_from = symbol, values_from = target_weight)
stock_dfs <- purrr::imap(stock_dfs, ~ .x %>%
arrange(date) %>%
mutate(
stock_dollars = if_else(
row_number() == 1,
portfolio_value0 * wide_weights[[.y]],
lag(stock_dollars) + lag(stock_dollars)*ret_cc
)))
tickers <- c("NVDA", "XOM", "AMZN", "WM")  # Example tickers in various industries
weights <- c(0.25, 0.25, 0.25, 0.25)  # Corresponding weights
initial_portfolio_value <- 100000    # Starting portfolio value
start_date = "2015-01-01"
end_date = rollback(Sys.Date(), roll_to_first = FALSE) # returns the last day of the prior month
tidyquant::tq_get(tickers,
get = "stock.prices",
from = start_date,
to = end_date)%>%
dplyr::select(symbol, date, open, close)%>%
dplyr::group_by(symbol) %>%
dplyr::mutate(log_cc = log(close/lag(close)),
log_oc = log(close/open),
log_co = log(open/lag(close)),
event = ifelse(lubridate::day(date) < lubridate::day(lag(date)),
1, ifelse(lead(day(date)) < day(date),2,0))
)
library(tidyverse)
library(rlang)
library(quantmod)
library(tidyquant)
library(lubridate)
library(gt)
tidyquant::tq_get(tickers,
get = "stock.prices",
from = start_date,
to = end_date)%>%
dplyr::select(symbol, date, open, close)%>%
dplyr::group_by(symbol) %>%
dplyr::arrange(symbol, date)%>%
dplyr::mutate(log_cc = log(close/lag(close)),
log_oc = log(close/open),
log_co = log(open/lag(close)),
event = ifelse(lubridate::day(date) < lubridate::day(lag(date)),
1, ifelse(lead(day(date)) < day(date),2,0)),
ret = ifelse(event == 1, log_cc,
ifelse(event == 2, log_co, log_cc))
)
long_df <- tidyquant::tq_get(tickers,
get = "stock.prices",
from = start_date,
to = end_date)%>%
dplyr::select(symbol, date, open, close)%>%
dplyr::group_by(symbol) %>%
dplyr::arrange(symbol, date)%>%
dplyr::mutate(log_cc = log(close/lag(close)),
log_oc = log(close/open),
log_co = log(open/lag(close)),
event = ifelse(lubridate::day(date) < lubridate::day(lag(date)),
1, ifelse(lead(day(date)) < day(date),2,0)),
ret = ifelse(event == 1, log_cc,
ifelse(event == 2, log_co, log_cc))
)
library(tidyverse)
library(rlang)
library(quantmod)
library(tidyquant)
library(lubridate)
library(gt)
tickers <- c("NVDA", "XOM", "AMZN", "WM")  # Example tickers in various industries
weights <- c(0.25, 0.25, 0.25, 0.25)  # Corresponding weights
initial_portfolio_value <- 100000    # Starting portfolio value
start_date = "2015-01-01"
end_date = rollback(Sys.Date(), roll_to_first = FALSE) # returns the last day of the prior month
long_df <- tidyquant::tq_get(tickers,
get = "stock.prices",
from = start_date,
to = end_date)%>%
dplyr::select(symbol, date, open, close)%>%
dplyr::group_by(symbol) %>%
dplyr::arrange(symbol, date)%>%
dplyr::mutate(log_cc = log(close/lag(close)),
log_oc = log(close/open),
log_co = log(open/lag(close)),
event = ifelse(lubridate::day(date) < lubridate::day(lag(date)),
1, ifelse(lead(day(date)) < day(date),2,0)),
ret = ifelse(event == 1, log_cc,
ifelse(event == 2, log_co, log_cc))
)
long_df %>%
dplyr::select()
View(long_df)
long_df %>%
dplyr::select(symbol, date, ret) %>%
tidyr::pivot_wider(names_from = symbol,
values_from = ret)
library(tidyverse)
library(rlang)
library(quantmod)
library(tidyquant)
library(lubridate)
library(gt)
?format_ISO8601
